# devenv.local.env — local, gitignored overrides for `devctl`.
#
# Copy to `devenv.local.env` and uncomment what you need. devctl sources this
# with `set -a`, so plain `NAME=value` lines are exported to the stack. A bare
# `devctl up` with none of these set runs a fully local, credential-free stack;
# everything here is opt-in.
#
#   cp devenv.local.env.example devenv.local.env

# --- Live services (use deployed dependencies instead of local stand-ins) ----
# Keys for the deployed services `devctl up --live <svc>` reaches. Only needed
# for the services you actually make live.
#GE_DEV_ES_API_KEY=
#GE_DEV_INFERENCE_API_KEY=
#GE_PERSPECTIVE_API_KEY=
# Make a live choice stick without passing flags every time (bare `up` still
# returns to all-local — this only sets the default when you pass --live):
#GE_DEV_LIVE=es,inference,perspective
#GE_DEV_LIVE_ENV=stage           # stage | prod

# --- Ports, binding, heap ----------------------------------------------------
# Published host ports (defaults in parens): override only on a conflict.
#GE_DEV_PORT_API=8300
#GE_DEV_PORT_FRONTEND=3000
#GE_DEV_PORT_ES=9201
#GE_DEV_PORT_FIRESTORE=8080
#GE_DEV_PORT_FIREBASE_AUTH=9099
#GE_DEV_PORT_FUNCTIONS=5001
#GE_DEV_PORT_FIREBASE_UI=4000
#GE_DEV_PORT_FIREBASE_UI_WS=9150
# Interface the ports bind to. 0.0.0.0 exposes them beyond loopback — see
# docs/remote.md for the security caveats first.
#GE_DEV_BIND=127.0.0.1
# Elasticsearch JVM heap. Drop to 512m to fit a second instance in memory.
#GE_DEV_ES_HEAP=1g
# Bind for the `devctl tunnel` ES port-forward (0.0.0.0 on native-Linux hosts).
#GE_DEV_ES_TUNNEL_BIND=127.0.0.1

# --- Repo root ---------------------------------------------------------------
# The directory holding the sibling checkouts (api, ingex, frontend, ...).
# Defaults to this internal-tools' parent; point it at another working copy
# (e.g. a git worktree) to mount different code. `up`/`pull` also take
# --repo-root, which wins over this.
#GE_DEV_REPO_ROOT=/path/to/greenearth-social

# --- Serve a local feed on real Bluesky (devctl bsky up/down) ----------------
# ngrok runs as a non-root container (no host install) and receives its
# authtoken through the container environment, not its readable tunnel config.
# Copy it from https://dashboard.ngrok.com/get-started/your-authtoken (a free
# account is enough). Required for `devctl bsky up`. Because this file contains
# secrets, keep your copied devenv.local.env mode 0600.
#NGROK_AUTHTOKEN=
# The dev bsky account whose repo the feed records are published into, and an
# app password for it (https://bsky.app/settings/app-passwords). Required for
# `devctl bsky up`.
#GE_DEV_BSKY_HANDLE=caterpie-internal.bsky.social
#GE_BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optional: a reserved ngrok domain gives a stable tunnel URL, so the feed
# records survive restarts (free ngrok gets a fresh random URL each time).
# GE_DEV_NGROK_DOMAIN sets the api tunnel; the *_API / *_FRONTEND forms set each
# tunnel independently (two stable domains let the frontend/OAuth half run on a
# free plan too).
#GE_DEV_NGROK_DOMAIN=your-api.ngrok.dev
#GE_DEV_NGROK_DOMAIN_API=your-api.ngrok.dev
#GE_DEV_NGROK_DOMAIN_FRONTEND=your-app.ngrok.dev

# --- Frontend real OAuth (advanced; usually leave unset) ---------------------
# `devctl bsky up` generates a throwaway dev OAuth keypair automatically — a
# client fully separate from prod (its client_id is your tunnel origin), so you
# do NOT need prod keys and normally set nothing here. Set these only to point
# the dev environment at externally-managed keys instead of the generated ones.
#BLUESKY_OAUTH_CLIENT_KID=
#BLUESKY_OAUTH_CLIENT_PRIVATE_KEY=
#BLUESKY_OAUTH_CLIENT_PRIVATE_KEY_STAGE=
#BLUESKY_OAUTH_PUBLIC_JWKS=
#OAUTH_STATE_ENCRYPTION_KEY=
#
# Managed automatically by `devctl bsky up` (the tunnel origin, allowed hosts,
# and taking the dev-auth shim out) — don't hand-edit these:
#   GE_DEV_APP_ORIGIN, GE_DEV_FRONTEND_ALLOWED_HOSTS, GE_DEV_FUNCTIONS_TARGET
